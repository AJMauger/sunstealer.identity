{
  "name": "sunstealer-identity",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "audit": "npm audit --audit-level=high --omit=dev --registry=https://registry.npmjs.org",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build --config vite.config.app.ts",
    "build:server": "vite build --config vite.config.node.ts",
    "clean": "run-script-os",
    "clean:linux": "rm -fr dist/* || true",
    "clean:win32": "rmdir /s /q .\\dist && mkdir .\\dist",
    "dev": "vite",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "npm run build && node ./dist/server.js"
  },
  "dependencies": {
    "@koa/ejs": "^5.1.0",
    "@koa/router": "^15.7.0",
    "axios": "^1.20.0",
    "jose": "^6.2.12",
    "koa": "^3.2.1",
    "koa-bodyparser": "^4.4.1",
    "mongodb": "^7.6.0",
    "oidc-provider": "^9.12.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0",
    "run-script-os": "^1.1.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@koa/cors": "^5.0.0",
    "@types/koa": "^3.0.3",
    "@types/koa__cors": "^5.0.1",
    "@types/koa__ejs": "^5.1.1",
    "@types/koa__router": "^12.0.5",
    "@types/koa-bodyparser": "^4.3.13",
    "@types/koa-mount": "^4.0.5",
    "@types/koa-send": "^4.1.6",
    "@types/koa-static": "^4.0.4",
    "@types/node": "^24.19.0",
    "@types/oidc-provider": "^9.12.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "koa-mount": "^4.2.0",
    "koa-send": "^5.0.1",
    "koa-static": "^5.0.0",
    "nodemon": "^1.14.10",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0",
    "vite-plugin-node-externals": "^0.0.1"
  }
}
